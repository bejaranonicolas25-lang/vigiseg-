window.addEventListener('error', function(e){ try{ var d=document.getElementById('diagnostico'); if(d) d.textContent='⚠️ Detecté un error, pero lo estoy conteniendo para que la página siga abriendo. Error: '+(e.message||'desconocido'); }catch(err){} return true; });
